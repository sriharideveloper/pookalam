# The backend automatically uses the first available image provider.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server-side Supabase publishing. Create a public `pookalams` table first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pookalams

# Optional canonical domain override. Vercel supplies its production URL automatically.
NEXT_PUBLIC_SITE_URL=
